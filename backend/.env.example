# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sgams
DB_USER=sgams_user
DB_PASSWORD=sgams_password

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_before_deployment
JWT_EXPIRES_IN=7d

# Pre-seeded professor account (only used when the account is first created)
ADMIN_SEED_PASSWORD=Admin@123

# Password reset tokens
RESET_TOKEN_TTL_MINUTES=15

# CORS (comma separated origins, or * for all)
CORS_ORIGIN=http://localhost:5173
